# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=                       # free: https://aistudio.google.com/apikey
GROQ_API_KEY=                         # free: https://console.groq.com/keys
OPENAI_API_KEY=                       # optional, paid
SCHOLARFIT_MODEL=gemini-flash-lite         # model used by the app (names from config/models.yaml)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/calendar/callback
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# EMBED_MODEL=BAAI/bge-small-en-v1.5   # enables hybrid retrieval if sentence-transformers is installed
